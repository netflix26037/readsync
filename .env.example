# Copy this file to .env and fill in real values for local development.
# On Vercel, set these same names under Project Settings → Environment Variables
# (or let the Upstash integration fill the two UPSTASH_ ones automatically).

ACCESS_CODE=5566
JWT_SECRET=change-this-to-a-random-string

UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxx
